#!/usr/bin/env python3
"""
OmaPony - Omarchy Media Downloader & Offline Whisper AI
Video & Audio Downloader with Offline Whisper Transcription and Subtitle Generation.
Supports YouTube, X (Twitter), Instagram, Facebook, TikTok, Reddit, and generic web videos.
"""

import sys
import os
import re
import json
import time
import shutil
import socket
import fcntl
import urllib.parse
import urllib.request
import subprocess
import argparse
import math
from pathlib import Path
from contextlib import contextmanager

# Paths
HOME = Path.home()
CONFIG_DIR = HOME / ".config" / "omarchy" / "omapony"
CONFIG_FILE = CONFIG_DIR / "config.json"
DATA_DIR = HOME / ".local" / "share" / "omarchy" / "omapony"
STATE_FILE = DATA_DIR / "state.json"
STATE_LOCK_FILE = DATA_DIR / ".state.lock"
MODELS_DIR = DATA_DIR / "models"
DEFAULT_VIDEO_DIR = HOME / "Videos" / "OmaPony"
DEFAULT_AUDIO_DIR = HOME / "Music" / "OmaPony"

def ensure_dirs():
    """Ensure essential directories exist lazily when needed."""
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    MODELS_DIR.mkdir(parents=True, exist_ok=True)


@contextmanager
def state_lock():
    """Advisory file lock to serialize state updates and queue scheduling across processes."""
    lock_fd = None
    try:
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        lock_fd = open(STATE_LOCK_FILE, "a")
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
        yield
    except Exception:
        yield
    finally:
        if lock_fd:
            try:
                fcntl.flock(lock_fd, fcntl.LOCK_UN)
                lock_fd.close()
            except Exception:
                pass


def get_socket_path():
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
    if runtime_dir and Path(runtime_dir).exists():
        return Path(runtime_dir) / "omapony.sock"
    return DATA_DIR / "omapony.sock"


def push_ipc(event):
    """Push real-time event directly to Quickshell BarWidget over Unix socket."""
    sock_path = get_socket_path()
    if not sock_path.exists():
        return
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(0.5)
        s.connect(str(sock_path))
        payload = json.dumps(event) + "\n"
        s.sendall(payload.encode("utf-8"))
        try:
            s.shutdown(socket.SHUT_WR)
        except Exception:
            pass
        s.close()
    except Exception:
        pass


def is_pid_running(pid):
    if not pid or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def load_config():
    defaults = {
        "download_dir": "~/Videos/OmaPony",
        "audio_dir": "~/Music/OmaPony",
        "default_format": "video",  # "video" or "audio"
        "auto_transcribe": False,
        "make_subtitles": True,
        "whisper_model": "base",    # "tiny", "base", "small"
        "whisper_engine": "auto",   # "auto", "whisper-cpp", "whisper"
        "max_concurrent": 2,
        "notify": True
    }
    if not CONFIG_FILE.exists():
        save_config(defaults)
        return defaults
    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
            defaults.update(data)
            return defaults
    except Exception:
        return defaults


def save_config(cfg):
    try:
        tmp = CONFIG_FILE.with_suffix(".tmp")
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(cfg, f, indent=2)
        tmp.replace(CONFIG_FILE)
    except Exception as e:
        print(f"Error saving config: {e}", file=sys.stderr)


def load_state():
    engine, available = detect_whisper_engine()
    empty = {
        "active": [],
        "history": [],
        "whisper_available": available,
        "whisper_engine": engine
    }
    if not STATE_FILE.exists():
        save_state(empty)
        return empty
    try:
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
            changed = False
            if data.get("whisper_available") != available or data.get("whisper_engine") != engine:
                data["whisper_available"] = available
                data["whisper_engine"] = engine
                changed = True
            if changed:
                save_state(data)
            return data
    except Exception:
        return empty


def save_state(st):
    try:
        content = json.dumps(st, indent=2)
        tmp = STATE_FILE.with_suffix(".tmp")
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        tmp.replace(STATE_FILE)
    except Exception as e:
        print(f"Error saving state: {e}", file=sys.stderr)


_whisper_engine_cache = None


def detect_whisper_engine():
    global _whisper_engine_cache
    if _whisper_engine_cache is not None:
        return _whisper_engine_cache
    # Priority 1: whisper-cli / whisper-cpp (fastest C++ implementation)
    if shutil.which("whisper-cli"):
        _whisper_engine_cache = "whisper-cli", True
        return _whisper_engine_cache
    if shutil.which("whisper.cpp"):
        _whisper_engine_cache = "whisper.cpp", True
        return _whisper_engine_cache
    # Priority 2: python-openai-whisper CLI
    if shutil.which("whisper"):
        _whisper_engine_cache = "whisper", True
        return _whisper_engine_cache
    # Priority 3: python module
    try:
        import faster_whisper
        _whisper_engine_cache = "faster_whisper", True
        return _whisper_engine_cache
    except ImportError:
        pass
    try:
        import whisper
        _whisper_engine_cache = "whisper-py", True
        return _whisper_engine_cache
    except ImportError:
        pass
    _whisper_engine_cache = "none", False
    return _whisper_engine_cache


def notify(title, message, urgency="normal", icon="video-x-generic"):
    try:
        subprocess.run(
            ["notify-send", "-a", "OmaPony", "-u", urgency, "-i", icon, title, message],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )
    except Exception:
        pass


def detect_platform(url):
    """
    Returns platform metadata dictionary:
    {
      'id': 'youtube' | 'x' | 'instagram' | 'facebook' | 'tiktok' | 'reddit' | 'web',
      'name': 'YouTube' | 'X / Twitter' | ...,
      'icon': '󰗃' | '󰕄' | ...,
      'color': '#FF0000' | '#1DA1F2' | ...
    }
    """
    if not url:
        return {
            "id": "unknown",
            "name": "Unknown",
            "icon": "󰈫",
            "color": "#888888"
        }

    url_lower = url.lower()

    # YouTube (detect playlist vs single video)
    if re.search(r'(?:youtube\.com|youtu\.be)', url_lower):
        if "list=" in url_lower or "/playlist" in url_lower:
            return {
                "id": "youtube",
                "name": "YouTube Playlist",
                "icon": "󰑋",
                "color": "#FF0000"
            }
        return {
            "id": "youtube",
            "name": "YouTube",
            "icon": "󰗃",
            "color": "#FF0000"
        }

    # X (Twitter)
    if re.search(r'(?:x\.com|twitter\.com)', url_lower):
        return {
            "id": "x",
            "name": "X / Twitter",
            "icon": "󰕄",
            "color": "#1DA1F2"
        }

    # Instagram
    if re.search(r'instagram\.com', url_lower):
        return {
            "id": "instagram",
            "name": "Instagram",
            "icon": "󰋙",
            "color": "#E1306C"
        }

    # Facebook
    if re.search(r'(?:facebook\.com|fb\.watch)', url_lower):
        return {
            "id": "facebook",
            "name": "Facebook",
            "icon": "󰈦",
            "color": "#1877F2"
        }

    # TikTok
    if re.search(r'tiktok\.com', url_lower):
        return {
            "id": "tiktok",
            "name": "TikTok",
            "icon": "󰎁",
            "color": "#00F2FE"
        }

    # Reddit
    if re.search(r'reddit\.com', url_lower):
        return {
            "id": "reddit",
            "name": "Reddit",
            "icon": "󰑍",
            "color": "#FF4500"
        }

    # Generic Web Video
    return {
        "id": "web",
        "name": "Web Video",
        "icon": "󰈫",
        "color": "#7AA2F7"
    }


def extract_url_from_text(text):
    if not text:
        return None
    # Match standard URLs
    matches = re.findall(r'https?://[^\s<>"\'`]+', text.strip())
    if matches:
        clean = matches[0].rstrip('.,;:!?)>"\'`')
        return clean
    return None


def get_selection_or_clipboard():
    # 1. Primary selection in Wayland
    try:
        res = subprocess.run(
            ["wl-paste", "--primary", "--no-newline"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False
        )
        if res.returncode == 0 and res.stdout.strip():
            url = extract_url_from_text(res.stdout)
            if url:
                return url, "selection"
    except Exception:
        pass

    # 2. Regular clipboard
    try:
        res = subprocess.run(
            ["wl-paste", "--no-newline"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False
        )
        if res.returncode == 0 and res.stdout.strip():
            url = extract_url_from_text(res.stdout)
            if url:
                return url, "clipboard"
    except Exception:
        pass

    return None, None


def is_playlist_url(url):
    if not url:
        return False
    u = url.lower()
    return "list=" in u or "/playlist" in u or "/sets/" in u


def extract_playlist_entries(url, max_entries=100):
    """
    Extracts entries from a playlist URL using yt-dlp flat-playlist.
    Returns (playlist_title, list_of_entries) where each entry has url, title, id.
    """
    cmd = [
        "yt-dlp",
        "--flat-playlist",
        "-J",
        "--playlist-end", str(max_entries),
        url
    ]
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=20)
        if res.returncode == 0 and res.stdout.strip():
            data = json.loads(res.stdout)
            if data.get("_type") == "playlist" and "entries" in data and len(data["entries"]) > 1:
                playlist_title = data.get("title") or "Playlist"
                entries = []
                for entry in data["entries"]:
                    if not entry:
                        continue
                    entry_url = entry.get("url")
                    entry_id = entry.get("id")
                    if not entry_url and entry_id:
                        if "youtube" in url or "youtu.be" in url:
                            entry_url = f"https://www.youtube.com/watch?v={entry_id}"
                        else:
                            entry_url = entry_id
                    elif entry_url and not entry_url.startswith("http"):
                        if "youtube" in url or "youtu.be" in url:
                            entry_url = f"https://www.youtube.com/watch?v={entry_url}"
                    if entry_url:
                        entries.append({
                            "url": entry_url,
                            "title": entry.get("title") or f"Video {len(entries) + 1}",
                            "id": entry_id or ""
                        })
                return playlist_title, entries
    except Exception as e:
        print(f"Playlist extraction error: {e}", file=sys.stderr)
    return None, []


def add_job(url, fmt, transcribe, subtitles, model, title=None):
    meta = detect_platform(url)
    job_id = f"dl_{int(time.time())}_{os.urandom(3).hex()}"
    job = {
        "id": job_id,
        "url": url,
        "platform": meta["name"],
        "platform_id": meta["id"],
        "platform_icon": meta["icon"],
        "platform_color": meta["color"],
        "title": title or f"Fetching metadata ({meta['name']})...",
        "format": fmt,
        "transcribe": bool(transcribe),
        "subtitles": bool(subtitles),
        "model": model,
        "status": "queued",
        "progress": 0.0,
        "speed": "--",
        "eta": "--",
        "downloaded_bytes": 0,
        "total_bytes": 0,
        "output_file": "",
        "subtitles_file": "",
        "transcript_file": "",
        "error_message": "",
        "pid": None,
        "created_at": int(time.time())
    }

    with state_lock():
        state = load_state()
        state.setdefault("active", []).append(job)
        save_state(state)

    return job_id


def process_queue():
    """
    Check concurrency limit (max_concurrent) and spawn workers for queued jobs.
    Called when new jobs are added, when workers finish, or on queue state changes.
    """
    to_spawn = []
    with state_lock():
        state = load_state()
        cfg = load_config()
        max_concurrent = int(cfg.get("max_concurrent", 2))
        if max_concurrent < 1:
            max_concurrent = 1

        active_jobs = state.get("active", [])
        running_count = 0

        # Check health of currently active workers
        for job in active_jobs:
            st = job.get("status")
            if st in ("downloading", "processing"):
                pid = job.get("pid")
                if pid and not is_pid_running(pid):
                    job["status"] = "error"
                    job["error_message"] = "Process terminated unexpectedly"
                else:
                    running_count += 1

        # Spawn queued jobs up to max_concurrent
        for job in active_jobs:
            if running_count >= max_concurrent:
                break
            if job.get("status") == "queued":
                job["status"] = "downloading"
                to_spawn.append(job["id"])
                running_count += 1

        save_state(state)

    for jid in to_spawn:
        spawn_worker(jid)

    if to_spawn:
        push_ipc({"type": "reload"})


def spawn_worker(job_id):
    script_path = os.path.abspath(__file__)
    subprocess.Popen(
        [sys.executable, script_path, "_worker", job_id],
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        stdin=subprocess.DEVNULL
    )


def spawn_transcribe_worker(job_id, media_file, model, subtitles, title):
    script_path = os.path.abspath(__file__)
    subprocess.Popen(
        [
            sys.executable, script_path, "_transcribe",
            job_id,
            str(media_file),
            str(model),
            "1" if subtitles else "0",
            str(title)
        ],
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        stdin=subprocess.DEVNULL
    )


def update_job_state(job_id, updates, state=None):
    if state is None:
        state = load_state()
    updated = False
    for job in state.get("active", []):
        if job.get("id") == job_id:
            job.update(updates)
            updated = True
            break
    if updated:
        save_state(state)


def download_whisper_model(model_name="base"):
    """
    Downloads GGML model for whisper-cpp if not already present
    """
    model_file = MODELS_DIR / f"ggml-{model_name}.bin"
    if model_file.exists() and model_file.stat().st_size > 1000000:
        return str(model_file)

    url = f"https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-{model_name}.bin"
    notify("Whisper Offline AI", f"Downloading {model_name} model for offline transcription...", icon="network-wireless")
    try:
        tmp_file = model_file.with_suffix(".tmp")
        urllib.request.urlretrieve(url, str(tmp_file))
        tmp_file.replace(model_file)
        return str(model_file)
    except Exception as e:
        print(f"Error downloading whisper model: {e}", file=sys.stderr)
        return None


def run_offline_whisper(media_file, model_name="base", generate_subtitles=True):
    """
    Runs offline whisper transcription on media_file.
    Generates .srt, .vtt, and .txt files alongside media_file.
    """
    media_path = Path(media_file)
    if not media_path.exists():
        return None, None

    engine, available = detect_whisper_engine()
    if not available:
        notify(
            "Whisper Offline AI",
            "Whisper is not installed.\nRun 'omarchy pkg add whisper-cpp' to enable offline transcription.",
            urgency="normal",
            icon="dialog-information"
        )
        return None, None

    base_output = str(media_path.with_suffix(""))
    wav_path = Path(f"/tmp/{media_path.stem}_whisper_{os.getpid()}.wav")

    try:
        # Step 1: Extract 16kHz mono audio (best format for Whisper)
        subprocess.run(
            ["ffmpeg", "-y", "-i", str(media_path), "-ar", "16000", "-ac", "1", "-c:a", "pcm_s16le", str(wav_path)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=True
        )

        # Step 2: Run Whisper engine
        if engine in ("whisper-cli", "whisper.cpp"):
            model_path = download_whisper_model(model_name)
            if not model_path:
                return None, None

            cmd = [
                engine,
                "-m", model_path,
                "-f", str(wav_path),
                "-otxt",
                "-of", base_output
            ]
            if generate_subtitles:
                cmd.extend(["-osrt", "-ovtt"])

            subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True)

        elif engine == "whisper":
            cmd = [
                "whisper",
                str(wav_path),
                "--model", model_name,
                "--output_format", "all" if generate_subtitles else "txt",
                "--output_dir", str(media_path.parent)
            ]
            subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True)

        srt_file = f"{base_output}.srt" if generate_subtitles else ""
        txt_file = f"{base_output}.txt"

        return srt_file if Path(srt_file).exists() else "", txt_file if Path(txt_file).exists() else ""

    except Exception as e:
        print(f"Whisper transcription failed: {e}", file=sys.stderr)
        return None, None
    finally:
        if wav_path.exists():
            try:
                wav_path.unlink()
            except Exception:
                pass


def cmd_detect(args):
    """Detect platform for given URL and output JSON"""
    url = args.url
    meta = detect_platform(url)
    print(json.dumps(meta))


def cmd_grab(args):
    """Grab link from selection/clipboard and initiate download with playlist fan-out"""
    url, source = get_selection_or_clipboard()
    if not url:
        notify("OmaPony", "No media URL found in selection or clipboard.", urgency="low", icon="dialog-warning")
        sys.exit(1)

    cfg = load_config()
    meta = detect_platform(url)

    fmt = args.format or cfg.get("default_format", "video")
    transcribe = args.transcribe if args.transcribe is not None else cfg.get("auto_transcribe", False)
    subtitles = args.subtitles if args.subtitles is not None else cfg.get("make_subtitles", True)
    model = args.model or cfg.get("whisper_model", "base")

    allow_playlist = args.playlist if args.playlist is not None else True
    if args.no_playlist:
        allow_playlist = False

    if allow_playlist and (args.playlist or is_playlist_url(url)):
        notify(
            f"OmaPony • {meta['name']}",
            f"Captured playlist link from {source}.\nInspecting entries...",
            icon="media-playlist-repeat"
        )
        pl_title, entries = extract_playlist_entries(url)
        if entries and len(entries) > 1:
            notify(
                "OmaPony • Playlist Enqueued",
                f"Queued {len(entries)} items from:\n{pl_title}",
                icon="media-playlist-repeat"
            )
            job_ids = []
            for entry in entries:
                jid = add_job(entry["url"], fmt, transcribe, subtitles, model, title=entry.get("title"))
                job_ids.append(jid)
            push_ipc({"type": "reload"})
            process_queue()
            print(json.dumps({"status": "queued", "count": len(job_ids), "playlist": pl_title, "job_ids": job_ids}))
            return

    notify(
        f"OmaPony • {meta['name']}",
        f"Captured {fmt.upper()} link from {source}.\nStarting download...",
        icon="video-x-generic"
    )

    job_id = add_job(url, fmt, transcribe, subtitles, model)
    push_ipc({"type": "reload"})
    process_queue()
    print(json.dumps({"status": "queued", "job_id": job_id, "url": url, "platform": meta["name"]}))


def cmd_add(args):
    """Add a download job manually with automatic playlist detection and fan-out"""
    url = extract_url_from_text(args.url) or args.url
    if not url.startswith("http"):
        print(json.dumps({"error": "Invalid URL"}), file=sys.stderr)
        sys.exit(1)

    cfg = load_config()
    fmt = args.format or cfg.get("default_format", "video")
    transcribe = args.transcribe if args.transcribe is not None else cfg.get("auto_transcribe", False)
    subtitles = args.subtitles if args.subtitles is not None else cfg.get("make_subtitles", True)
    model = args.model or cfg.get("whisper_model", "base")

    allow_playlist = args.playlist if args.playlist is not None else True
    if args.no_playlist:
        allow_playlist = False

    if allow_playlist and (args.playlist or is_playlist_url(url)):
        notify("OmaPony • Playlist", "Inspecting playlist entries...", icon="media-playlist-repeat")
        pl_title, entries = extract_playlist_entries(url)
        if entries and len(entries) > 1:
            notify(
                "OmaPony • Playlist Enqueued",
                f"Added {len(entries)} items from playlist:\n{pl_title}",
                icon="media-playlist-repeat"
            )
            job_ids = []
            for entry in entries:
                jid = add_job(entry["url"], fmt, transcribe, subtitles, model, title=entry.get("title"))
                job_ids.append(jid)
            push_ipc({"type": "reload"})
            process_queue()
            print(json.dumps({"status": "queued", "count": len(job_ids), "playlist": pl_title, "job_ids": job_ids}))
            return

    job_id = add_job(url, fmt, transcribe, subtitles, model)
    push_ipc({"type": "reload"})
    process_queue()
    print(json.dumps({"status": "queued", "job_id": job_id}))


def cmd_worker(args):
    """Background worker process executing download for a job"""
    job_id = args.job_id
    state = load_state()
    job = None
    for j in state.get("active", []):
        if j.get("id") == job_id:
            job = j
            break

    if not job:
        print(f"Job {job_id} not found", file=sys.stderr)
        process_queue()
        return

    cfg = load_config()
    raw_dir = cfg.get("audio_dir" if job["format"] == "audio" else "download_dir") or ("~/Music/OmaPony" if job["format"] == "audio" else "~/Videos/OmaPony")
    out_dir = Path(os.path.expanduser(raw_dir))
    out_dir.mkdir(parents=True, exist_ok=True)

    out_template = str(out_dir / "%(title)s [%(id)s].%(ext)s")

    cmd = [
        "yt-dlp",
        "--no-playlist",
        "--newline",
        "--no-colors",
        "--progress",
        "--progress-template",
        "download:PROG:%(progress._percent_str)s|%(progress._speed_str)s|%(progress._eta_str)s|%(progress.downloaded_bytes)s|%(progress.total_bytes)s|%(progress.total_bytes_estimate)s|%(info.format_id)s|%(info.vcodec)s|%(info.acodec)s|%(info.title)s",
        "--print", "after_move:FINAL:%(filepath)s",
        "-o", out_template
    ]

    if job["format"] == "audio":
        cmd.extend(["-x", "--audio-format", "mp3", "--audio-quality", "0"])
    else:
        cmd.extend(["-f", "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best", "--merge-output-format", "mp4"])

    cmd.append(job["url"])

    start_time = time.time()
    with state_lock():
        update_job_state(job_id, {
            "status": "downloading",
            "progress": 2.0,
            "speed": "Connecting...",
            "eta": "--",
            "pid": os.getpid()
        })

    final_path = ""
    last_disk_time = 0
    saw_video_stream = False
    last_video_pct = 2.0
    last_audio_pct = 85.0
    last_general_pct = 2.0
    last_pct = 2.0
    title = job.get("title", "")
    if "Fetching metadata" in title:
        title = ""

    recent_lines = []
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)

        for raw_line in proc.stdout:
            clean_line = re.sub(r'\x1b\[[0-9;]*[a-zA-Z]', '', raw_line).strip()
            if clean_line:
                recent_lines.append(clean_line)
                if len(recent_lines) > 25:
                    recent_lines.pop(0)

            if clean_line.startswith("FINAL:"):
                final_path = clean_line[6:].strip()
                last_pct = max(last_pct, 99.0)
                with state_lock():
                    update_job_state(job_id, {
                        "output_file": final_path,
                        "progress": 99.0,
                        "speed": "Finalizing...",
                        "eta": "0s"
                    })

            elif "has already been downloaded" in clean_line:
                m = re.search(r'\[download\]\s+(.+?)\s+has already been downloaded', clean_line)
                if m:
                    final_path = m.group(1).strip()
                    last_pct = 100.0

            elif "Destination:" in clean_line:
                parts = clean_line.split("Destination:", 1)
                dest = parts[1].strip() if len(parts) > 1 else ""
                if dest and not dest.endswith(".part") and not final_path:
                    final_path = dest

            elif "Merging formats into" in clean_line:
                m = re.search(r'Merging formats into ["\'](.+?)["\']', clean_line)
                if m:
                    final_path = m.group(1).strip()

            elif clean_line.startswith("[Merger]") or clean_line.startswith("[ExtractAudio]") or "Merging formats" in clean_line:
                last_pct = max(last_pct, 98.5)
                with state_lock():
                    update_job_state(job_id, {
                        "progress": last_pct,
                        "speed": "Processing...",
                        "eta": "finishing"
                    })

            elif "PROG:" in clean_line:
                try:
                    parts = clean_line.split("PROG:")[1].split("|")
                    pct_raw = re.sub(r'[^0-9.]', '', parts[0]) if len(parts) > 0 else ""
                    spd = parts[1].strip() if len(parts) > 1 else "--"
                    eta = parts[2].strip() if len(parts) > 2 else "--"
                    dl_b = int(parts[3]) if len(parts) > 3 and parts[3].isdigit() else 0
                    tot_b = int(parts[4]) if len(parts) > 4 and parts[4].isdigit() else 0
                    tot_est = int(parts[5]) if len(parts) > 5 and parts[5].isdigit() else 0
                    fmt_id = parts[6].strip() if len(parts) > 6 else ""
                    vcodec = parts[7].strip() if len(parts) > 7 else ""
                    acodec = parts[8].strip() if len(parts) > 8 else ""
                    parsed_title = "|".join(parts[9:]).strip() if len(parts) > 9 else ""

                    if parsed_title and parsed_title != "NA" and not title:
                        title = parsed_title

                    raw_pct = float(pct_raw) if pct_raw else 0.0
                    effective_total = tot_b if tot_b > 0 else tot_est
                    if raw_pct <= 0.0 and effective_total > 0 and dl_b > 0:
                        raw_pct = min(99.0, (dl_b / effective_total) * 100.0)
                    elif raw_pct <= 0.0 and dl_b > 0:
                        raw_pct = min(90.0, 5.0 + math.log10(max(1, dl_b / 10000)) * 22.0)

                    # Guard against DASH init fragment reporting 100% on <100KB
                    if raw_pct >= 99.0 and dl_b > 0 and dl_b < 100000:
                        raw_pct = 0.5

                    # Multi-stream scaling:
                    is_audio_stream = (vcodec == 'none' or 'audio' in fmt_id.lower()) and acodec != 'none'
                    if job["format"] == "video":
                        if not is_audio_stream and vcodec != 'none':
                            saw_video_stream = True

                        if is_audio_stream and saw_video_stream:
                            # Audio stream following video stream: scales from 85% to 97%
                            scaled_pct = 85.0 + (raw_pct * 0.12)
                            last_audio_pct = max(last_audio_pct, scaled_pct)
                            scaled_pct = last_audio_pct
                        else:
                            # Video stream: scales from 2% to 85%
                            scaled_pct = 2.0 + (raw_pct * 0.83)
                            last_video_pct = max(last_video_pct, scaled_pct)
                            scaled_pct = last_video_pct
                    else:
                        # Audio-only download: scales from 2% to 97%
                        scaled_pct = 2.0 + (raw_pct * 0.95)
                        last_general_pct = max(last_general_pct, scaled_pct)
                        scaled_pct = last_general_pct

                    scaled_pct = min(99.0, scaled_pct)
                    last_pct = max(last_pct, scaled_pct)

                    now = time.time()
                    if now - last_disk_time >= 0.10 or scaled_pct >= 99.0:
                        last_disk_time = now
                        with state_lock():
                            update_job_state(job_id, {
                                "progress": round(scaled_pct, 1),
                                "speed": spd,
                                "eta": eta,
                                "downloaded_bytes": dl_b,
                                "total_bytes": effective_total,
                                "title": title or job.get("title", "")
                            })
                except Exception:
                    pass

            elif clean_line.startswith("[download]") and "%" in clean_line:
                # Fallback parser for standard yt-dlp progress lines
                m = re.search(r'([0-9.]+)%\s+of\s+([~0-9.a-zA-Z]+)\s+at\s+([0-9.a-zA-Z/]+)\s+ETA\s+([0-9:]+)', clean_line)
                if m:
                    try:
                        raw_pct = float(m.group(1))
                        spd = m.group(3)
                        eta = m.group(4)
                        if job["format"] == "video":
                            if saw_video_stream:
                                # Likely the audio stream after video was downloaded
                                scaled_pct = 85.0 + (raw_pct * 0.13)
                            else:
                                # Video stream: 3% → 85%
                                scaled_pct = max(3.0, raw_pct * 0.85)
                        else:
                            scaled_pct = max(3.0, raw_pct * 0.98)

                        scaled_pct = max(last_pct, min(99.0, scaled_pct))
                        last_pct = scaled_pct

                        now = time.time()
                        if now - last_disk_time >= 0.10 or scaled_pct >= 99.0:
                            last_disk_time = now
                            with state_lock():
                                update_job_state(job_id, {
                                    "progress": round(scaled_pct, 1),
                                    "speed": spd,
                                    "eta": eta,
                                    "title": title or job.get("title", "")
                                })
                    except Exception:
                        pass

        proc.wait()

        if proc.returncode != 0:
            err_line = next((l for l in reversed(recent_lines) if "error" in l.lower()), None) or (recent_lines[-1] if recent_lines else "unknown error")
            err = f"yt-dlp error (code {proc.returncode}): {err_line}"
            with state_lock():
                update_job_state(job_id, {"status": "error", "error_message": err})
            notify("OmaPony", f"Failed to download {title or job['url']}: {err_line}", urgency="critical", icon="dialog-error")
            process_queue()
            return

        if not final_path or not Path(final_path).exists():
            url_val = job.get("url", "")
            id_match = re.search(r'(?:v=|youtu\.be/|videos/|reel/|p/)([a-zA-Z0-9_-]+)', url_val)
            cand_id = id_match.group(1) if id_match else ""
            matches = [f for f in out_dir.glob(f"*{cand_id}*") if f.is_file() and not f.name.endswith(".part")] if cand_id else []
            if matches:
                matches.sort(key=lambda f: f.stat().st_mtime, reverse=True)
                final_path = str(matches[0])
            else:
                cutoff = time.time() - 120
                recent = [f for f in out_dir.glob("*") if f.is_file() and not f.name.endswith(".part") and f.stat().st_mtime >= cutoff]
                if recent:
                    recent.sort(key=lambda f: f.stat().st_mtime, reverse=True)
                    final_path = str(recent[0])

        should_transcribe = bool(job.get("transcribe")) and bool(final_path)

        # Set job as completed 100% in active list so user sees full completion & horse at finish line
        with state_lock():
            update_job_state(job_id, {
                "status": "completed",
                "progress": 100.0,
                "speed": "Complete",
                "eta": "0s",
                "output_file": final_path,
                "title": title or Path(final_path).name
            })

        # Add to history immediately
        with state_lock():
            state = load_state()
            history_entry = {
                "id": job_id,
                "url": job["url"],
                "platform": job["platform"],
                "platform_id": job.get("platform_id", "web"),
                "platform_icon": job["platform_icon"],
                "platform_color": job["platform_color"],
                "title": title or Path(final_path).name,
                "format": job["format"],
                "transcribed": should_transcribe,
                "transcribing": should_transcribe,
                "has_subtitles": False,
                "output_file": final_path,
                "subtitles_file": "",
                "transcript_file": "",
                "file_size": f"{Path(final_path).stat().st_size / (1024*1024):.1f} MB" if final_path and Path(final_path).exists() else "",
                "completed_at": int(time.time())
            }
            state.setdefault("history", []).insert(0, history_entry)
            state["history"] = state["history"][:50]
            save_state(state)

        # Completion notification
        notify(
            f"✓ Download Complete • {job['platform']}",
            f"{title or Path(final_path).name}\nSaved to {Path(final_path).parent}",
            icon="video-x-generic"
        )

        # Immediately free queue slot so next download begins without waiting
        process_queue()

        # Detached background transcription if enabled
        if should_transcribe:
            spawn_transcribe_worker(
                job_id=job_id,
                media_file=final_path,
                model=job.get("model", "base"),
                subtitles=job.get("subtitles", True),
                title=title or Path(final_path).name
            )

        # Hold the 100% completed card for 1.2s so the user clearly sees full completion & horse at finish line
        time.sleep(1.2)
        with state_lock():
            state = load_state()
            state["active"] = [j for j in state.get("active", []) if j.get("id") != job_id]
            save_state(state)
        return

    except Exception as e:
        with state_lock():
            update_job_state(job_id, {"status": "error", "error_message": str(e)})
        notify("OmaPony", f"Error: {e}", urgency="critical", icon="dialog-error")
        push_ipc({"type": "reload"})
        process_queue()


def cmd_transcribe(args):
    """Background worker for detached Whisper AI transcription"""
    job_id = args.job_id
    media_file = args.media_file
    model = args.model
    subtitles = args.subtitles == "1"
    title = args.title

    notify(
        "Whisper Offline AI",
        f"Transcribing '{title}' offline using Whisper {model}...",
        icon="audio-x-generic"
    )

    srt_res, txt_res = run_offline_whisper(
        media_file,
        model_name=model,
        generate_subtitles=subtitles
    )

    with state_lock():
        state = load_state()
        for item in state.get("history", []):
            if item.get("id") == job_id:
                item["transcribing"] = False
                item["subtitles_file"] = srt_res or ""
                item["transcript_file"] = txt_res or ""
                item["has_subtitles"] = bool(srt_res)
                break
        save_state(state)

    push_ipc({"type": "reload"})

    if srt_res:
        notify(
            "✓ Subtitles Ready • Whisper AI",
            f"Generated subtitles for {title}",
            icon="audio-x-generic"
        )
    else:
        notify(
            "✓ Transcription Ready • Whisper AI",
            f"Transcript generated for {title}",
            icon="audio-x-generic"
        )


def cmd_cancel(args):
    """Cancel an active download or queued job"""
    job_id = args.job_id
    with state_lock():
        state = load_state()
        target = None
        for j in state.get("active", []):
            if j.get("id") == job_id:
                target = j
                break
        if target and target.get("pid"):
            try:
                os.kill(target["pid"], 9)
            except Exception:
                pass
        state["active"] = [j for j in state.get("active", []) if j.get("id") != job_id]
        save_state(state)

    push_ipc({"type": "reload"})
    process_queue()
    print(json.dumps({"status": "cancelled", "job_id": job_id}))


def cmd_clear_history(args):
    """Clear completed downloads history"""
    with state_lock():
        state = load_state()
        state["history"] = []
        save_state(state)
    push_ipc({"type": "reload"})
    print(json.dumps({"status": "cleared"}))


def cmd_open(args):
    """Open downloaded file or directory with default application"""
    path = args.path
    if not path or not Path(path).exists():
        return
    subprocess.Popen(["xdg-open", path], start_new_session=True)


def cmd_open_dir(args):
    """Open folder in file manager"""
    cfg = load_config()
    default_dir = os.path.expanduser(cfg.get("download_dir") or "~/Videos/OmaPony")
    path = args.path or default_dir
    p = Path(os.path.expanduser(path))
    if p.is_file():
        p = p.parent
    p.mkdir(parents=True, exist_ok=True)
    subprocess.Popen(["xdg-open", str(p)], start_new_session=True)


def cmd_toggle(args):
    """Summon / toggle the Quickshell UI panel via IPC"""
    subprocess.run(["omarchy-shell", "omapony", "toggle"], check=False)


def cmd_status(args):
    """Output current state in JSON after validating queue health"""
    process_queue()
    with state_lock():
        st = load_state()
    print(json.dumps(st, indent=2))


def cmd_install_whisper(args):
    """Launch terminal to install whisper-cpp via omarchy pkg add"""
    script = (
        "echo -e '\\033[1;36m====================================================\\033[0m'; "
        "echo -e '\\033[1;36m           OmaPony: Install Whisper AI              \\033[0m'; "
        "echo -e '\\033[1;36m====================================================\\033[0m\\n'; "
        "echo 'Installing whisper-cpp for 100% offline transcription...\\n'; "
        "if omarchy pkg add whisper-cpp; then "
        "  echo -e '\\n\\033[1;32m[OK] whisper-cpp successfully installed!\\033[0m'; "
        "  omapony status >/dev/null 2>&1; "
        "else "
        "  echo -e '\\n\\033[1;31m[FAILED] Could not install whisper-cpp automatically.\\033[0m'; "
        "  echo 'Try manually running: sudo pacman -S whisper-cpp'; "
        "fi; "
        "echo ''; "
        "read -n 1 -s -r -p 'Press any key to close this terminal...'"
    )
    term_cmd = None
    for candidate in ["omarchy-launch-terminal", "xdg-terminal-exec", "ghostty", "foot", "kitty"]:
        if shutil.which(candidate):
            term_cmd = candidate
            break
    if term_cmd:
        subprocess.Popen([term_cmd, "bash", "-c", script], start_new_session=True)
    else:
        notify("OmaPony", "Run in terminal: omarchy pkg add whisper-cpp", urgency="critical")


def main():
    parser = argparse.ArgumentParser(description="OmaPony - Omarchy Media Downloader & Offline Whisper AI")
    subparsers = parser.add_subparsers(dest="command")

    # grab: superkey command
    p_grab = subparsers.add_parser("grab", help="Grab link from selection/clipboard and download")
    p_grab.add_argument("--format", choices=["video", "audio"], default=None)
    p_grab.add_argument("--transcribe", action="store_true", default=None)
    p_grab.add_argument("--no-transcribe", action="store_false", dest="transcribe")
    p_grab.add_argument("--subtitles", action="store_true", default=None)
    p_grab.add_argument("--model", choices=["tiny", "base", "small"], default=None)
    p_grab.add_argument("--playlist", action="store_true", default=None, help="Force playlist extraction")
    p_grab.add_argument("--no-playlist", action="store_true", default=False, help="Do not extract playlist")

    # add: manual URL download
    p_add = subparsers.add_parser("add", help="Add URL to download queue")
    p_add.add_argument("url", help="Media URL")
    p_add.add_argument("--format", choices=["video", "audio"], default="video")
    p_add.add_argument("--transcribe", action="store_true", default=False)
    p_add.add_argument("--subtitles", action="store_true", default=True)
    p_add.add_argument("--model", choices=["tiny", "base", "small"], default="base")
    p_add.add_argument("--playlist", action="store_true", default=None, help="Force playlist extraction")
    p_add.add_argument("--no-playlist", action="store_true", default=False, help="Do not extract playlist")

    # detect
    p_detect = subparsers.add_parser("detect", help="Detect platform for URL")
    p_detect.add_argument("url", help="URL to inspect")

    # cancel
    p_cancel = subparsers.add_parser("cancel", help="Cancel active or queued job")
    p_cancel.add_argument("job_id", help="Job ID to cancel")

    # clear-history
    subparsers.add_parser("clear-history", help="Clear completed downloads history")

    # open & open-dir
    p_open = subparsers.add_parser("open", help="Open file")
    p_open.add_argument("path", help="Path to file")

    p_opendir = subparsers.add_parser("open-dir", help="Open folder")
    p_opendir.add_argument("path", nargs="?", default="", help="Path to directory")

    # toggle / summon
    subparsers.add_parser("toggle", help="Toggle downloader UI panel")
    subparsers.add_parser("summon", help="Summon downloader UI panel")

    # status
    subparsers.add_parser("status", help="Get JSON status")

    # install-whisper
    subparsers.add_parser("install-whisper", help="Install whisper-cpp for offline transcription")

    # internal worker
    p_worker = subparsers.add_parser("_worker", help=argparse.SUPPRESS)
    p_worker.add_argument("job_id", help="Job ID")

    # internal detached transcription worker
    p_transcribe = subparsers.add_parser("_transcribe", help=argparse.SUPPRESS)
    p_transcribe.add_argument("job_id", help="Job ID")
    p_transcribe.add_argument("media_file", help="Media File Path")
    p_transcribe.add_argument("model", help="Whisper Model")
    p_transcribe.add_argument("subtitles", help="Subtitles Flag")
    p_transcribe.add_argument("title", help="Media Title")

    args = parser.parse_args()
    ensure_dirs()

    if not args.command or args.command in ("summon", "toggle"):
        cmd_toggle(args)
    elif args.command == "grab":
        cmd_grab(args)
    elif args.command == "add":
        cmd_add(args)
    elif args.command == "detect":
        cmd_detect(args)
    elif args.command == "cancel":
        cmd_cancel(args)
    elif args.command == "clear-history":
        cmd_clear_history(args)
    elif args.command == "open":
        cmd_open(args)
    elif args.command == "open-dir":
        cmd_open_dir(args)
    elif args.command == "status":
        cmd_status(args)
    elif args.command == "install-whisper":
        cmd_install_whisper(args)
    elif args.command == "_worker":
        cmd_worker(args)
    elif args.command == "_transcribe":
        cmd_transcribe(args)


if __name__ == "__main__":
    main()
